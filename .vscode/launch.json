{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/${relativeFileDirname}/output/${fileBasenameNoExtension}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "为 gdb 启用整齐打印",
          "text": "enable pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "clear debuginfod URLs",
          "text": "set debuginfod urls",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "编译",

    }
  ]
}